rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Any authenticated Firebase user created in your Firebase Console is an authorized administrator
    function isAuthorizedAdmin() {
      return request.auth != null && request.auth.token.email != null;
    }

    // Portal configuration & question bank: readable by candidates, editable ONLY by Admin
    match /portal_config/{docId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    // Live active assessment proctoring telemetry
    match /active_sessions/{sessionId} {
      allow create, update, delete: if true;
      allow read: if isAuthorizedAdmin();
    }

    // Candidate ID / Register-number uniqueness index
    match /reg_locks/{regNo} {
      allow get: if true;
      allow create: if !exists(/databases/$(database)/documents/reg_locks/$(regNo));
      allow update, delete, list: if isAuthorizedAdmin();
    }

    // Candidate assessment submissions
    match /submissions/{submissionId} {
      allow get: if true;
      allow list, delete: if isAuthorizedAdmin();

      allow create: if !exists(/databases/$(database)/documents/submissions/$(submissionId))
        && request.resource.data.email is string
        && request.resource.data.fullName is string
        && request.resource.data.score is number;

      allow update: if isAuthorizedAdmin();
    }
  }
}
