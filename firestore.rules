rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Any authenticated Firebase user created in your Firebase Console is an authorized administrator
    function isAuthorizedAdmin() {
      return request.auth != null && request.auth.token.email != null;
    }

    // Portal general configuration (branding, active slots, titles)
    // Questions bank: NEVER readable by arbitrary unauthenticated clients. Server API handles question delivery!
    match /portal_config/main {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    match /portal_config/assessment_drives {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    // Full question bank containing correct answers: ADMIN ONLY
    match /portal_config/{docId} {
      allow read, write: if isAuthorizedAdmin();
    }

    // Live active assessment proctoring telemetry
    match /active_sessions/{sessionId} {
      allow create, update, delete: if true;
      allow read: if isAuthorizedAdmin();
    }

    // Candidate ID / Register-number uniqueness index
    match /reg_locks/{regNo} {
      allow get: if true;
      allow create: if !exists(/databases/$(database)/documents/reg_locks/$(regNo));
      allow update, delete, list: if isAuthorizedAdmin();
    }

    // Candidate assessment submissions
    // Candidates submit through the secure server grading API (/api/assessment/submit).
    // Direct client submission creations are locked to server or verified admin to prevent score tampering.
    match /submissions/{submissionId} {
      allow get: if isAuthorizedAdmin();
      allow list, delete: if isAuthorizedAdmin();
      allow create, update: if isAuthorizedAdmin();
    }
  }
}
